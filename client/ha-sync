#!/usr/bin/env bash
set -euo pipefail

ENV_FILE="${CODEX_HA_ENV_FILE:-$HOME/.config/codex-ha/env}"
CA_FILE="${CODEX_HA_CA_FILE:-$HOME/.config/codex-ha/bridge-ca.crt}"
WORK="${CODEX_HA_WORKSPACE:-$HOME/homeassistant-workspace}"

if [[ ! -r "$ENV_FILE" ]]; then
  echo "Cannot read bridge environment file: $ENV_FILE" >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$ENV_FILE"

: "${CODEX_HA_BRIDGE_TOKEN:?CODEX_HA_BRIDGE_TOKEN is not set}"
: "${CODEX_HA_BRIDGE_URL:?CODEX_HA_BRIDGE_URL is not set}"

export CODEX_HA_BRIDGE_TOKEN CODEX_HA_BRIDGE_URL
export CODEX_HA_CA_FILE="$CA_FILE" CODEX_HA_WORKSPACE="$WORK"

python3 - "$@" <<'PY'
import json
import os
import ssl
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

BASE = os.environ["CODEX_HA_BRIDGE_URL"].rstrip("/")
TOKEN = os.environ["CODEX_HA_BRIDGE_TOKEN"]
CA = Path(os.environ["CODEX_HA_CA_FILE"])
WORK = Path(os.environ["CODEX_HA_WORKSPACE"])

if not CA.is_file():
    raise SystemExit(f"CA certificate not found: {CA}")

ctx = ssl.create_default_context(cafile=str(CA))


def request(method, endpoint, remote=None, data=None, allow_404=False):
    url = BASE + endpoint
    if remote is not None:
        url += "?" + urllib.parse.urlencode({"path": remote})

    req = urllib.request.Request(
        url,
        data=data,
        method=method,
        headers={"Authorization": f"Bearer {TOKEN}"},
    )

    try:
        with urllib.request.urlopen(req, context=ctx, timeout=30) as resp:
            body = resp.read()
            ctype = resp.headers.get("Content-Type", "")
            if "json" in ctype:
                return resp.status, json.loads(body)
            return resp.status, body
    except urllib.error.HTTPError as exc:
        body = exc.read().decode(errors="replace")
        if allow_404 and exc.code == 404:
            return 404, body
        raise SystemExit(f"HTTP {exc.code}: {body}")
    except urllib.error.URLError as exc:
        raise SystemExit(f"Bridge connection failed: {exc.reason}")


def local_path(remote):
    remote = remote.rstrip("/") or "/homeassistant"
    if remote != "/homeassistant" and not remote.startswith("/homeassistant/"):
        raise SystemExit(
            "Remote path must be /homeassistant or start with /homeassistant/"
        )
    return WORK / remote.lstrip("/")


def pull(remote):
    status, listing = request("GET", "/list", remote, allow_404=True)
    if status == 200:
        dest = local_path(remote)
        dest.mkdir(parents=True, exist_ok=True)
        for item in listing["entries"]:
            child = remote.rstrip("/") + "/" + item["name"]
            if item["type"] == "directory":
                pull(child)
            else:
                _, data = request("GET", "/file", child)
                out = local_path(child)
                out.parent.mkdir(parents=True, exist_ok=True)
                out.write_bytes(data)
                print("PULL", child)
        return

    _, data = request("GET", "/file", remote)
    out = local_path(remote)
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_bytes(data)
    print("PULL", remote)


def push(arg):
    path = Path(arg).expanduser().resolve()
    root = WORK.resolve()

    try:
        rel = path.relative_to(root)
    except ValueError:
        raise SystemExit(f"File must be inside {WORK}")

    if not path.is_file():
        raise SystemExit(f"Not a file: {path}")

    remote = "/" + rel.as_posix()
    _, result = request("PUT", "/file", remote, path.read_bytes())
    print("PUSH", remote)
    print(json.dumps(result, indent=2))


def delete(remote):
    status, result = request("DELETE", "/file", remote, allow_404=True)
    if status == 404:
        print("ABSENT", remote)
        return
    print("DELETE", remote)
    if isinstance(result, dict):
        print(json.dumps(result, indent=2))
    else:
        print(result)


def mkdir(remote):
    _, result = request("POST", "/mkdir", remote)
    print("MKDIR", remote)
    print(json.dumps(result, indent=2))


def ls(remote):
    _, result = request("GET", "/list", remote)
    print(json.dumps(result, indent=2))


def usage():
    print(
        """ha-sync commands:

  ha-sync ls [REMOTE_DIR]
  ha-sync pull /homeassistant/PATH
  ha-sync push "$HOME/homeassistant-workspace/homeassistant/PATH"
  ha-sync delete /homeassistant/PATH
  ha-sync mkdir /homeassistant/PATH

Environment overrides:
  CODEX_HA_ENV_FILE
  CODEX_HA_CA_FILE
  CODEX_HA_WORKSPACE

Examples:
  ha-sync ls /homeassistant
  ha-sync pull /homeassistant/configuration.yaml
  ha-sync pull /homeassistant/packages
  ha-sync pull /homeassistant/esphome
  ha-sync push "$HOME/homeassistant-workspace/homeassistant/packages/codex/example.yaml"
  ha-sync delete /homeassistant/packages/codex/example.yaml
""".strip()
    )


if len(sys.argv) < 2:
    usage()
    raise SystemExit(2)

cmd = sys.argv[1]

if cmd == "pull" and len(sys.argv) == 3:
    pull(sys.argv[2])
elif cmd == "push" and len(sys.argv) == 3:
    push(sys.argv[2])
elif cmd == "delete" and len(sys.argv) == 3:
    delete(sys.argv[2])
elif cmd == "mkdir" and len(sys.argv) == 3:
    mkdir(sys.argv[2])
elif cmd == "ls" and len(sys.argv) in (2, 3):
    ls(sys.argv[2] if len(sys.argv) == 3 else "/homeassistant")
elif cmd in ("-h", "--help", "help"):
    usage()
else:
    usage()
    raise SystemExit(2)
PY
